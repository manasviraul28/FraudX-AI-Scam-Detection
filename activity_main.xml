<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#0D1117"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ── TOP HEADER ── -->
    <LinearLayout
        android:orientation="horizontal"
        android:background="#161B22"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:text="FraudX"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#E6EDF3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="● AI Shield Active"
                android:textSize="11sp"
                android:textColor="#58D68D"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnScanTop"
            android:text="Scan"
            android:textSize="12sp"
            android:textColor="#0D1117"
            android:backgroundTint="#58A6FF"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </LinearLayout>

    <!-- ── DEMO BUTTON ── -->
    <Button
        android:id="@+id/btnDemoData"
        android:text="⚡ Load Demo Data"
        android:textSize="12sp"
        android:textColor="#0D1117"
        android:backgroundTint="#FF7B7B"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"/>

    <!-- ── SYNC STATUS BAR ── -->
    <TextView
        android:id="@+id/tvSyncStatus"
        android:text="Syncing scam database..."
        android:textSize="11sp"
        android:textColor="#8B949E"
        android:background="#0D1117"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- ── QUICK STATS ROW ── -->
    <LinearLayout
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="12dp"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp">
            <TextView
                android:id="@+id/tvCallCount"
                android:text="0"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#58A6FF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:text="Calls"
                android:textSize="10sp"
                android:textColor="#8B949E"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="12dp"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp">
            <TextView
                android:id="@+id/tvSmsCount"
                android:text="0"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#58A6FF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:text="SMS"
                android:textSize="10sp"
                android:textColor="#8B949E"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="12dp"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:id="@+id/tvThreatCount"
                android:text="0"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FF7B7B"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:text="Threats"
                android:textSize="10sp"
                android:textColor="#8B949E"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

    </LinearLayout>

    <!-- ── TAB ROW ── -->
    <LinearLayout
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tabAll"
            android:text="All"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#58A6FF"
            android:background="@drawable/tab_selected"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginEnd="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tabCalls"
            android:text="Calls"
            android:textSize="13sp"
            android:textColor="#8B949E"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginEnd="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tabSms"
            android:text="SMS"
            android:textSize="13sp"
            android:textColor="#8B949E"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginEnd="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tabThreats"
            android:text="Threats"
            android:textSize="13sp"
            android:textColor="#FF7B7B"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <!-- ── LIVE LOG LIST ── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerLog"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- ── BOTTOM NAV ── -->
    <LinearLayout
        android:orientation="horizontal"
        android:background="#161B22"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/navHome"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">
            <TextView android:text="🏠" android:textSize="20sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView android:text="Home" android:textSize="9sp"
                android:textColor="#58A6FF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navVault"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">
            <TextView android:text="🔐" android:textSize="20sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView android:text="Vault" android:textSize="9sp"
                android:textColor="#8B949E"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navScan"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/pill_status"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">
            <TextView android:text="🔍" android:textSize="20sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView android:text="Scan" android:textSize="9sp"
                android:textColor="#58A6FF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navBlocked"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">
            <TextView android:text="🚫" android:textSize="20sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView android:text="Blocked" android:textSize="9sp"
                android:textColor="#8B949E"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navHistory"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">
            <TextView android:text="📋" android:textSize="20sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView android:text="History" android:textSize="9sp"
                android:textColor="#8B949E"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>